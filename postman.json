		{
			"name": "Filters",
			"item": [
				{
					"name": "Get Filter Config",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/filters/config",
							"host": ["{{baseUrl}}"],
							"path": ["api", "filters", "config"]
						},
						"description": "Get the current filter configuration including mode (blacklist/whitelist) and all patterns."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"version\": 2,\n  \"mode\": \"blacklist\",\n  \"exclude\": [\"*.tmp\", \"node_modules/**\"],\n  \"include\": [],\n  \"blacklist_exclude\": [\"*.tmp\", \"node_modules/**\"],\n  \"blacklist_include\": [],\n  \"whitelist_include\": [\"*.pdf\", \"*.docx\"],\n  \"whitelist_exclude\": [],\n  \"config_path\": \"/Users/username/Library/Application Support/cosma/filter.json\"\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Update Filter Config",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mode\": \"blacklist\",\n  \"blacklist_exclude\": [\"*.tmp\", \"*.log\", \"node_modules/**\"],\n  \"apply_immediately\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/filters/config",
							"host": ["{{baseUrl}}"],
							"path": ["api", "filters", "config"]
						},
						"description": "Update filter configuration. All fields are optional. Set apply_immediately to true to remove newly-excluded files from the index right away."
