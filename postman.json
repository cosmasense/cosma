					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"enabled\": true,\n  \"combine_mode\": \"ALL\",\n  \"check_interval_seconds\": 30,\n  \"rules\": [\n    {\n      \"type\": \"battery_level\",\n      \"operator\": \"gt\",\n      \"value\": 50,\n      \"enabled\": true\n    },\n    {\n      \"type\": \"power_source\",\n      \"operator\": \"eq\",\n      \"value\": true,\n      \"enabled\": true\n    }\n  ],\n  \"conditions_met\": true\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
