						"method": "DELETE",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pattern\": \"*.log\",\n  \"pattern_type\": \"exclude\"\n}"
