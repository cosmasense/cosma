							"body": "{\n  \"items\": [\n    {\n      \"id\": \"abc-123\",\n      \"file_path\": \"/Users/yourname/Downloads/doc.pdf\",\n      \"action\": \"INDEX\",\n      \"status\": \"COOLING_DOWN\",\n      \"enqueued_at\": 1705312200.0,\n      \"cooldown_expires_at\": 1705312260.0,\n      \"dest_path\": null,\n      \"retry_count\": 0\n    }\n  ]\n}",
