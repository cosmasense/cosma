						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patterns\": [\"*.pdf\", \"*.log\"],\n  \"file_paths\": [\"/tmp/doc.pdf\", \"/tmp/app.log\", \"/tmp/image.png\"],\n  \"mode\": \"whitelist\"\n}"
