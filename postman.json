{
	"info": {
		"_postman_id": "cosmasense-api-collection",
		"name": "CosmaSense API",
		"description": "Complete API collection for CosmaSense backend (http://localhost:60534). 25 endpoints across 9 blueprints: Status, Watch, Index, Search, Files, Queue, Filters, Settings, and Updates (SSE).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:60534",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Status",
			"item": [
				{
					"name": "Get Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/status/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "status", ""]
						},
						"description": "Returns the number of active watch jobs."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"jobs\": 1\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				}
			]
		},
		{
			"name": "Watch & Index",
			"item": [
				{
					"name": "Watch Directory",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"directory_path\": \"/Users/yourname/Downloads\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/watch/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "watch", ""]
						},
						"description": "Start watching a directory. Creates a watch job, starts file system watcher, and begins initial indexing."
					},
					"response": [
						{
							"name": "201 Created",
							"status": "Created",
							"code": 201,
							"body": "{\n  \"success\": true,\n  \"message\": \"Started watching directory: /Users/yourname/Downloads\",\n  \"files_indexed\": 0\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "List Watch Jobs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/watch/jobs",
							"host": ["{{baseUrl}}"],
							"path": ["api", "watch", "jobs"]
						},
						"description": "List all watched directories (active and inactive)."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"jobs\": [\n    {\n      \"id\": 1,\n      \"path\": \"/Users/yourname/Downloads\",\n      \"is_active\": true,\n      \"recursive\": true,\n      \"file_pattern\": null,\n      \"last_scan\": \"2025-01-15T10:30:00\",\n      \"created_at\": \"2025-01-15T10:30:00\",\n      \"updated_at\": \"2025-01-15T14:22:00\"\n    }\n  ]\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Delete Watch Job",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/watch/jobs/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "watch", "jobs", "1"]
						},
						"description": "Stop watching a directory and remove all its indexed files. Replace '1' with the job ID."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Successfully deleted watched directory: /Users/yourname/Downloads\",\n  \"job_id\": 1\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						},
						{
							"name": "404 Not Found",
							"status": "Not Found",
							"code": 404,
							"body": "{\n  \"success\": false,\n  \"message\": \"Watched directory with ID 99 not found\",\n  \"job_id\": 99\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Index Directory",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"directory_path\": \"/Users/yourname/Documents\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/index/directory",
							"host": ["{{baseUrl}}"],
							"path": ["api", "index", "directory"]
						},
						"description": "Trigger indexing of all files in a directory (without creating a persistent watch job)."
					},
					"response": [
						{
							"name": "201 Created",
							"status": "Created",
							"code": 201,
							"body": "{\n  \"success\": true,\n  \"message\": \"Started indexing directory: /Users/yourname/Documents\",\n  \"files_indexed\": 0\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Index Single File",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"file_path\": \"/Users/yourname/Documents/report.pdf\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/index/file",
							"host": ["{{baseUrl}}"],
							"path": ["api", "index", "file"]
						},
						"description": "Index a single file through the full pipeline (parse → summarize → embed)."
					},
					"response": [
						{
							"name": "201 Created",
							"status": "Created",
							"code": 201,
							"body": "{\n  \"success\": true,\n  \"message\": \"Successfully indexed file: /Users/yourname/Documents/report.pdf\",\n  \"file_id\": null\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				}
			]
		},
		{
			"name": "Search & Files",
			"item": [
				{
					"name": "Search Files",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"meeting notes about project roadmap\",\n  \"limit\": 10,\n  \"directory\": null,\n  \"filters\": null\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/search/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "search", ""]
						},
						"description": "Hybrid semantic + keyword search across all indexed files. Supports optional directory scoping and filters."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"results\": [\n    {\n      \"file\": {\n        \"file_path\": \"/Users/yourname/Downloads/report.pdf\",\n        \"filename\": \"report.pdf\",\n        \"extension\": \".pdf\",\n        \"created\": \"2025-01-10T09:00:00\",\n        \"modified\": \"2025-01-14T16:30:00\",\n        \"accessed\": \"2025-01-15T10:00:00\",\n        \"title\": \"Q4 Project Roadmap\",\n        \"summary\": \"Quarterly roadmap covering milestones...\",\n        \"keywords\": [\"roadmap\", \"project\", \"milestones\"]\n      },\n      \"relevance_score\": 0.85\n    }\n  ]\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Get File Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/files/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "files", "stats"]
						},
						"description": "Get aggregate statistics about indexed files."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"total_files\": 400,\n  \"total_size\": 0,\n  \"file_types\": {\n    \".pdf\": 45,\n    \".docx\": 12,\n    \".jpg\": 200\n  },\n  \"last_indexed\": \"2025-01-15T14:22:00\"\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				},
				{
					"name": "Get File by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/files/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "files", "1"]
						},
						"description": "Retrieve a single file's metadata by its database ID. Replace '1' with the file ID."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"id\": 1,\n  \"filename\": \"report.pdf\",\n  \"extension\": \".pdf\",\n  \"created\": \"2025-01-10T09:00:00\",\n  \"modified\": \"2025-01-14T16:30:00\",\n  \"summary\": \"Quarterly roadmap...\",\n  \"keywords\": [\"roadmap\", \"project\"]\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						},
						{
							"name": "404 Not Found",
							"status": "Not Found",
							"code": 404,
							"body": "{\n  \"error\": \"File not found\"\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
				}
			]
		},
		{
			"name": "Queue & Scheduler",
			"item": [
				{
					"name": "Get Queue Status",
					"request": {
						"method": "GET",
						"header": [],
