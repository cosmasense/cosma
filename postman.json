							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Removed exclude pattern: *.log\"\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
						}
					]
