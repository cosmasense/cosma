						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"results\": [\n    {\"file_path\": \"/tmp/doc.pdf\", \"included\": true, \"matched_pattern\": \"*.pdf\"},\n    {\"file_path\": \"/tmp/app.log\", \"included\": true, \"matched_pattern\": \"*.log\"},\n    {\"file_path\": \"/tmp/image.png\", \"included\": false, \"matched_pattern\": null}\n  ]\n}",
