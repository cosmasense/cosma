							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"enabled\": false,\n  \"combine_mode\": \"ALL\",\n  \"check_interval_seconds\": 30,\n  \"rules\": [],\n  \"conditions_met\": true\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
