					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Filter configuration updated successfully\",\n  \"config\": { \"...\" : \"...\" },\n  \"removed_count\": 15\n}",
