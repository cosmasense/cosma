						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Added exclude pattern: *.log\",\n  \"removed_count\": 3\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
