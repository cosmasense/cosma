							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"paused\": false,\n  \"manually_paused\": false,\n  \"scheduler_paused\": false,\n  \"total_items\": 0,\n  \"cooling_down\": 0,\n  \"ready\": 0,\n  \"processing\": 0\n}",
							"header": [{"key": "Content-Type", "value": "application/json"}]
